<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="28dp" android:background="@color/bg_dark">
    <TextView android:text="@string/login_title" android:textColor="@color/neon_green"
        android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="32dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etUser" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/hint_user"
        android:textColorHint="@color/neon_cyan" android:textColor="@color/text_white"
        android:background="@drawable/bg_neon" android:padding="16dp" android:layout_marginBottom="14dp"/>
    <EditText android:id="@+id/etPass" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/hint_pass"
        android:inputType="textPassword" android:textColorHint="@color/neon_cyan"
        android:textColor="@color/text_white" android:background="@drawable/bg_neon"
        android:padding="16dp" android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/btn_login"
        android:textColor="@color/bg_dark" android:backgroundTint="@color/neon_green"/>
</LinearLayout>
