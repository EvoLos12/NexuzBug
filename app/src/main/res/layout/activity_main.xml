<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="28dp" android:background="@color/bg_dark">
    <TextView android:text="@string/menu_title" android:textColor="@color/neon_green"
        android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="36dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnDelay" android:layout_width="match_parent"
        android:layout_height="70dp" android:text="@string/btn_delay"
        android:textColor="@color/bg_dark" android:textStyle="bold" android:textSize="18sp"
        android:backgroundTint="@color/neon_cyan" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnFc" android:layout_width="match_parent"
        android:layout_height="70dp" android:text="@string/btn_fc"
        android:textColor="@color/text_white" android:textStyle="bold" android:textSize="18sp"
        android:backgroundTint="@color/neon_red"/>
</LinearLayout>
